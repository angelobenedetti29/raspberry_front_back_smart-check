# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Environment files (secrets). config.json *sí* se versiona.
.env

# Estado de enrolamiento del nodo (contiene el secret). No versionar.
/device*.json

# Lock y temporales de la escritura atómica de config.json (raíz)
config.json.lock
*.tmp
.tmp-*

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/

# Large media files
multimedia/videos/
*.mp4
*.avi
*.mkv

# Generated inference artifacts
multimedia/output/

# Model binaries (not versioned: generate them from ai_training/)
*.onnx
*.hef
*.pt

# Hailo DFC intermediate files, datasets and YOLO training runs
*.har
*.npy
ai_training/runs/

# Streaming pipeline runtime data
streaming/data/*
!streaming/data/.gitkeep

# Deepwork session state (local only)
.slim/deepwork/
