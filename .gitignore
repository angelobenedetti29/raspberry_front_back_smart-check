# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Environment files (secrets). config.json *sí* se versiona.
.env

# Estado de enrolamiento del nodo (contiene el secret). No versionar.
/device*.json

# Lock y temporales de la escritura atómica de config.json (raíz)
config.json.lock
*.tmp
.tmp-*

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/

# Hailo DFC intermediate files, datasets and YOLO training runs
*.har
*.npy
backend/ai_training/runs/
backend/ai_training/*.alls
backend/ai_training/*_nms.json

# Streaming pipeline runtime data
streaming/data/*
!streaming/data/.gitkeep

# Base SQLite de eventos y su rotación (runtime)
data/*.db*

# Audit log de control y su rotación (runtime)
data/control_audit.jsonl*

# Video de prueba pesado: se usa local, no se versiona (supera el límite de GitHub)
multimedia/videos/t3.mp4

# Grafo local de graphify y config de OpenCode (solo local)
graphify-out/
.opencode/

# Deepwork session state (local only)
.slim/deepwork/
