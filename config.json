{
    "stream": {
        "capture": {
            "source": "t1.mp4",
            "width": 1280,
            "height": 720,
            "fps": 30,
            "loop_video": true,
            "buffer_size": 1,
            "stable_frames": 30,
            "read_timeout_seconds": 5.0
        },
        "publisher": {
            "server_url": "rtsp://smartcheck.duckdns.org:8554",
            "bitrate": "2M",
            "ffmpeg_executable": "ffmpeg",
            "encoder": "libx264",
            "preset": "ultrafast",
            "tune": "zerolatency",
            "pixel_format": "yuv420p",
            "rtsp_transport": "tcp",
            "gop_seconds": 2,
            "b_frames": 0,
            "queue_size": 2,
            "write_timeout": 0.5,
            "stable_seconds": 5.0
        },
        "inference": {
            "image_size": 640,
            "confidence_threshold": 0.6,
            "nms_threshold": 0.4
        },
        "preview": {
            "fps": 15
        },
        "storage": {
            "max_bytes": 26214400,
            "max_files": 20,
            "persist_no_detection_every": 300
        },
        "reconnect": {
            "initial_seconds": 1.0,
            "max_seconds": 30.0
        },
        "counting": {
            "enabled": true,
            "line_y": 540
        }
    },
    "models": {
        "default_model_id": "salida-horno-v4",
        "catalog": [
            {
                "model_id": "yolo11n-coco",
                "label": "YOLOv11 Original (COCO)",
                "file": "yolo11n.onnx",
                "names_file": "class.names",
                "class_thresholds": {}
            },
            {
                "model_id": "tostadas-v1",
                "label": "YOLOv26 Tostadas V1 (Custom)",
                "file": "tostadas_v1.onnx",
                "names_file": "tostadas_v1.names",
                "class_thresholds": {
                    "tostada quemada": 0.3,
                    "tostadas ok": 0.6
                }
            },
            {
                "model_id": "tostadas-v2",
                "label": "YOLOv26 Tostadas V2 (Custom)",
                "file": "tostadas_v2.onnx",
                "names_file": "tostadas_v2.names",
                "class_thresholds": {
                    "tcq": 0.3,
                    "tcok": 0.6
                }
            },
            {
                "model_id": "tostadas-v3",
                "label": "YOLOv11 Tostadas V3 (Retraining)",
                "file": "tostadas_retraining_v3.onnx",
                "names_file": "tostadas_retraining_v3.names",
                "class_thresholds": {
                    "tcq": 0.45,
                    "tcok": 0.55,
                    "chaq": 0.45,
                    "chaok": 0.55,
                    "chacr": 0.5
                }
            },
            {
                "model_id": "yolov8s-hailo",
                "label": "YOLOv8s NPU (Hailo-8L COCO)",
                "file": "/usr/share/hailo-models/yolov8s_h8l.hef",
                "names_file": "class.names",
                "class_thresholds": {}
            },
            {
                "model_id": "entrada-horno-v1.3",
                "label": "YOLO Entrada Horno V1.3",
                "file": "entrada_horno_1.3.onnx",
                "names_file": "entrada_horno_1.3.names",
                "class_thresholds": {
                    "fajita": 0.55,
                    "tc": 0.50
                }
            },
            {
                "model_id": "salida-horno-v4",
                "label": "YOLO Salida Horno V4",
                "file": "salida_horno_V4.onnx",
                "names_file": "salida_horno_V4.names",
                "class_thresholds": {
                    "chaok": 0.55,
                    "chaq": 0.45,
                    "tcok": 0.55,
                    "tcq": 0.45
                }
            }
        ]
    },
    "paths": {
        "videos_dir": "multimedia/videos",
        "models_dir": "models",
        "data_dir": "data"
    },
    "api": {
        "base_url": "https://backend-smart-check-automation-go.onrender.com",
        "registration_requests_endpoint": "/api/v1/registration-requests/",
        "dispositivos_ping_endpoint": "/api/v1/dispositivos/ping",
        "dispositivos_nombre_endpoint": "/api/v1/dispositivos/nombre",
        "dispositivos_rename_url_endpoint": "/api/v1/dispositivos/rename-url",
        "productos_endpoint": "/api/v1/productos",
        "dispositivos_sector_endpoint": "/api/v1/dispositivos/sector",
        "lotes_endpoint": "/api/v1/lotes"
    },
    "device": {
        "hostname": "rb-1",
        "ping_interval_seconds": 15.0,
        "registration_poll_interval_seconds": 5.0,
        "public_url": "http://192.168.100.8:9000",
        "listen_address": "0.0.0.0",
        "local_port": 9000
    },
    "lote": {
        "habilitado": true,
        "cierre_sin_detecciones_segundos": 30.0,
        "flush_segundos": 2.0,
        "max_eventos_por_envio": 50,
        "cola_eventos": 512,
        "max_pendientes": 5000,
        "refresco_catalogo_segundos": 300.0,
        "reintento_inicial_segundos": 1.0,
        "reintento_maximo_segundos": 30.0,
        "dlq_path": "dlq.jsonl",
        "dlq_max_bytes": 5242880,
        "dlq_max_files": 5
    },
    "control": {
        "habilitado": true,
        "publicar_telemetria_segundos": 5.0,
        "poll_consigna_propuesta_segundos": 3.0,
        "metricas_horno_endpoint": "/api/v1/lotes/{id}/metricas-horno",
        "consigna_propuesta_endpoint": "/api/v1/lotes/{id}/consigna-propuesta",
        "aplicar_consigna_endpoint": "/api/v1/lotes/{id}/aplicar-consigna",
        "consigna_ack_endpoint": "/api/v1/lotes/{id}/consigna/ack",
        "lotes_modo_endpoint": "/api/v1/lotes/{id}/modo",
        "audit_path": "control_audit.jsonl",
        "audit_max_bytes": 5242880,
        "audit_max_files": 5,
        "consigna_reg_temp1": 100,
        "consigna_reg_vel": 104,
        "umbral_marcha_temp_c": 50.0,
        "umbral_marcha_velocidad": 0.01,
        "sensores": {
            "driver": "modbus_tcp",
            "host": "127.0.0.1",
            "port": 5020
        },
        "actuadores": {
            "driver": "modbus_tcp",
            "host": "127.0.0.1",
            "port": 5020
        }
    },
    "notificaciones": {
        "habilitado": true,
        "umbral_anomalia": 1,
        "ventana_segundos": 10.0,
        "cooldown_segundos": 5.0
    }
}