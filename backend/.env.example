# Smart-Check Raspberry — backend/CLI environment template.
# Copy to backend/.env (backend) or pass to the CLI with
#   python -m device_enrollment enroll --env-file /absolute/path/device.env
# Never commit real secrets; this file only holds safe placeholders.

# --- Device proof transport (replaces the legacy shared API key) ------------
# Must end in /api/v1.
DEVICE_API_BASE_URL=https://api.example.com/api/v1
# Audience configured on the Go verifier (DEVICE_AUTH_AUDIENCE).
DEVICE_AUTH_AUDIENCE=https://api.example.com/api/v1

# --- One-time invitation ----------------------------------------------------
# 43-character case-sensitive unpadded base64url. Removed automatically after a
# durable enrollment; never pass it on the command line.
DEVICE_ENROLLMENT_CODE=

# --- Local identity storage (service-owned, directory 0700, files 0600) -----
DEVICE_IDENTITY_DIR=/var/lib/smart-check/device

# --- Business defaults ------------------------------------------------------
HORNO_ID=
PRODUCTO_ID=
PING_INTERVAL_SECONDS=10
